    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kids-store/database": "workspace:*",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "zod": "^4.4.3"
  }
}
