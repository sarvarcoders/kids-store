{
  "name": "@kids-store/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @kids-store/core build",
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm --filter @kids-store/core build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kids-store/core": "workspace:*",
    "@kids-store/database": "workspace:*",
    "@kids-store/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.22.5"
  }
}
