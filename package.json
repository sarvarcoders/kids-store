{
  "name": "kids-store",
  "version": "0.1.0",
  "private": true,
  "description": "Bolalar kiyimlari sotadigan Telegram do'kon uchun monorepo",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:mini-app": "pnpm --filter @kids-store/mini-app build",
    "dev": "pnpm --filter @kids-store/bot dev",
    "dev:mini-app": "pnpm --filter @kids-store/mini-app dev",
    "lint": "eslint .",
    "lint:mini-app": "pnpm --filter @kids-store/mini-app lint",
    "start": "pnpm --filter @kids-store/bot start",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:mini-app": "pnpm --filter @kids-store/mini-app typecheck",
    "db:generate": "pnpm --filter @kids-store/database db:generate",
    "db:migrate": "pnpm --filter @kids-store/database db:migrate",
    "db:deploy": "pnpm --filter @kids-store/database db:deploy",
    "db:seed": "pnpm --filter @kids-store/database db:seed",
    "db:studio": "pnpm --filter @kids-store/database db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^24.13.3",
    "eslint": "^10.7.0",
    "tsx": "^4.22.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
