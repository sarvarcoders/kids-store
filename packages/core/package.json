{
  "name": "@kids-store/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @kids-store/database build && pnpm --filter @kids-store/shared build",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm run build",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kids-store/database": "workspace:*",
    "@kids-store/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.22.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
